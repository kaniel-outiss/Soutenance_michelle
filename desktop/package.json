{
  "name": "soutenance-michelle",
  "version": "2.1.1",
  "description": "Préparation à la soutenance — RSE et performance sociale de l'OAPI",
  "author": "Boss",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --win --publish never" },
  "devDependencies": { "electron": "30.0.0", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.pianotools.soutenance",
    "productName": "Soutenance Michelle",
    "files": ["main.js", "index.html", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.ico",
      "target": [ { "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] } ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Soutenance Michelle",
      "artifactName": "Soutenance-Michelle-Setup.exe"
    },
    "portable": { "artifactName": "Soutenance-Michelle-portable.exe" }
  }
}
